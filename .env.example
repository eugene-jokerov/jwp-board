# Параметры docker compose для JWP Board.
# Копируется в .env командой `make init-envs` (см. Makefile).

# Имя compose-проекта (префикс имён контейнеров).
COMPOSE_PROJECT_NAME=jwp-board

# Пользователь внутри php-контейнера (обычно совпадает с uid/gid хоста).
APP_USER=jwp
APP_UID=1000
APP_GID=1000
TIMEZONE=Europe/Moscow

# --- Порты на хосте ---
# Nginx -> API (http://localhost:8080/api/v1/health)
API_HTTP_PORT=8080
# Expo / Metro (React Native dev server)
EXPO_PORT=8081
EXPO_DEVTOOLS_PORT=19000
EXPO_DEVTOOLS_A_PORT=19001
EXPO_DEVTOOLS_B_PORT=19002
# MySQL: основная БД и БД для тестов
MYSQL_PORT=3307
MYSQL_TEST_PORT=3308
# phpMyAdmin (профиль tools)
PHPMYADMIN_PORT=8082

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=jwp_board
MYSQL_TEST_DATABASE=jwp_board_test
MYSQL_USER=jwp
MYSQL_PASSWORD=jwp

# --- PHP / Xdebug ---
# off | develop | debug | trace. Включайте debug только когда нужна отладка:
# xdebug сильно замедляет тесты и PHPStan.
PHP_XDEBUG_MODE=off
PHP_XDEBUG_PORT=9003
PHP_XDEBUG_HOST=host.docker.internal
