root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,mjs,cjs,json,yml,yaml,neon,md,html,css,scss}]
indent_size = 2

[*.{php,blade.php}]
indent_size = 4

[*.neon]
indent_size = 4

[Makefile]
indent_style = tab

[docker-compose*.yml]
indent_size = 2
