APP_NAME="JWP Board"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Внутри сети docker API доступен по имени сервиса nginx.
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL (сервис mysql из docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jwp_board
DB_USERNAME=jwp
DB_PASSWORD=jwp

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@jwp-board.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS ---
# Через запятую список Origin или * для всех (мобильный клиент Origin не присылает).
CORS_ALLOWED_ORIGINS="*"
