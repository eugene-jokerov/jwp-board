APP_NAME="JWP Board"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Внутри сети docker API доступен по имени сервиса nginx.
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL (сервис mysql из docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jwp_board
DB_USERNAME=jwp
DB_PASSWORD=jwp

# --- Сессии (веб-клиент: вход по cookie) ---
# Веб-клиент аутентифицируется сессией, поэтому драйвер по умолчанию — database
# (таблица sessions уже есть в миграции users). Тесты используют array.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Домены веб-клиента, которые Sanctum считает «frontend»: для них включаются
# сессия, cookie и проверка CSRF. Мобильный клиент Origin не присылает и в этот
# список не входит — он работает по Bearer-токену.
SANCTUM_STATEFUL_DOMAINS=localhost:8081,localhost,127.0.0.1:8081

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@jwp-board.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS ---
# Через запятую список Origin. Для веба нужен конкретный origin: с credentials
# (cookie сессии) браузер отклоняет '*' как небезопасный wildcard.
# Мобильный клиент Origin не присылает, поэтому от этого списка не зависит.
CORS_ALLOWED_ORIGINS="http://localhost:8081"
