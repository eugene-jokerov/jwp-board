*.log
.DS_Store
.env
.env.backup
.env.production
.phpunit.result.cache
/.idea
/.vscode
/.phpunit.cache
/auth.json
/node_modules
/public/storage
# Скомпилированные Blade-вью и прочий рантайм-кэш Laravel. IDE может добавлять
# их в патчи как новые файлы: коммитить такой мусор нельзя.
/storage/framework/views/*.php
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
# локальные переопределения анализаторов/окружения
/phpstan.neon
/.env.mysql-test
