# Общие игнор-правила монорепозитория JWP Board.
# Правила конкретного приложения (backend/.gitignore, mobile/.gitignore)
# добавляются скелетами Laravel и Expo — не дублируем их здесь.

# IDE
.idea/
.vscode/
*.iml

# Окружение compose (шаблон .env.example коммитится, .env — только локально)
/.env
/.env.local

# Временные артефакты инструментов разработки (скриншоты, профили браузера,
# одноразовые скрипты проверок). В историю не попадают.
.tmp-shot/

# Python-кэш: остаётся от вспомогательных скриптов проверок.
__pycache__/
*.pyc
